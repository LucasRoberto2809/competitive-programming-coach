# Chat completions compatible text model. Provider is configurable.
CP_LLM_MODEL=
CP_LLM_BASE_URL=https://api.openai.com/v1
CP_LLM_API_KEY=
# Optional full endpoint override:
# CP_LLM_CHAT_COMPLETIONS_URL=https://provider.example/v1/chat/completions
CP_LLM_TEMPERATURE=0.2

# Typed decisions and response evaluation (optional in local development).
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

# Runtime controls. ADMIN is trusted host config, never a chat command.
CP_FRAMEWORK_MODE=USER
CP_MAX_REVISIONS=2
CP_EVALUATOR_PASS_THRESHOLD=85
CP_HTTP_TIMEOUT_SECONDS=30
CP_REQUIRE_JEV=0
# CP_FRAMEWORK_ROOT=C:\path\to\competitive-programming-coach
# CP_DATA_DIR=C:\path\to\local\source-cache
# GITHUB_TOKEN=optional-token-to-increase-GitHub-API-rate-limit
